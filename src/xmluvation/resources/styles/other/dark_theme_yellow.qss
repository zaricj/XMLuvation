/* XMLuvation dark theme.
 * Generated from one template shared with the other default theme, so both stay in sync.
 * Widgets opt into styles with the dynamic "role" property set in the .ui files:
 *   sidebar, nav, page, page-title, card, card-title, hint, field-label, status, link,
 *   code, log, primary, accent, danger, flat, transparent, dock, segmented, result,
 *   result-title, error.
 * Spacing scale: 4 / 8 / 12 / 16 / 24 px. Radius: 6 px controls, 10 px cards.
 */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog, QWidget[role="page"] {
    background-color: #1b1d22;
    color: #e6e8ec;
}

QWidget {
    color: #e6e8ec;
    selection-background-color: rgba(255, 200, 87, 0.35);
    selection-color: #e6e8ec;
}

QWidget[role="transparent"],
QScrollArea > QWidget#qt_scrollarea_viewport {
    background: transparent;
}

QToolTip {
    background-color: #23262d;
    color: #e6e8ec;
    border: 1px solid #2f333b;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---------------------------------------------------------------- shell */

QFrame[role="sidebar"] {
    background-color: #15171b;
    border: none;
    border-right: 1px solid #2f333b;
}

QLabel[role="app-title"] {
    font-size: 15pt;
    font-weight: 600;
    padding: 0 6px;
}

QFrame[role="sidebar"] QLabel[role="hint"] {
    padding: 0 6px;
}

QListWidget[role="nav"] {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget[role="nav"]::item {
    color: #9399a4;
    padding: 9px 10px;
    margin: 2px 0;
    border-radius: 6px;
    border-left: 3px solid transparent;
}

QListWidget[role="nav"]::item:hover {
    background-color: #353a44;
    color: #e6e8ec;
}

QListWidget[role="nav"]::item:selected {
    background-color: rgba(255, 200, 87, 0.18);
    color: #e6e8ec;
    border-left: 3px solid #ffc857;
    font-weight: 600;
}

QLabel[role="page-title"] {
    font-size: 17pt;
    font-weight: 600;
}

QLabel[role="hint"] {
    color: #9399a4;
}

QLabel[role="field-label"] {
    color: #9399a4;
    font-weight: 600;
    padding-right: 4px;
}

QLabel[role="status"] {
    color: #f0b44c;
    font-weight: 600;
}

QLabel[role="link"] {
    color: #ffd788;
}

QFrame[role="card"] {
    background-color: #23262d;
    border: 1px solid #2f333b;
    border-radius: 10px;
}

QFrame[role="card"] QLabel {
    background: transparent;
}

QLabel[role="card-title"] {
    font-size: 11.5pt;
    font-weight: 600;
}

QMenuBar {
    background-color: #15171b;
    border-bottom: 1px solid #2f333b;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #353a44;
}

QMenu {
    background-color: #23262d;
    border: 1px solid #2f333b;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: rgba(255, 200, 87, 0.18);
}

QMenu::item:disabled {
    color: #646a74;
}

QMenu::separator {
    height: 1px;
    background: #2f333b;
    margin: 6px 4px;
}

QStatusBar {
    background-color: #15171b;
    border-top: 1px solid #2f333b;
    color: #9399a4;
}

QStatusBar::item {
    border: none;
}

QDockWidget {
    color: #9399a4;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #15171b;
    border-top: 1px solid #2f333b;
    padding: 6px 14px;
    text-align: left;
}

QWidget[role="dock"] {
    background-color: #15171b;
}

QSplitter::handle {
    background: transparent;
}

QSplitter::handle:hover {
    background-color: rgba(255, 200, 87, 0.18);
    border-radius: 3px;
}

QMainWindow::separator {
    background: #2f333b;
    height: 1px;
    width: 1px;
}

QMainWindow::separator:hover {
    background: #ffc857;
}

/* ---------------------------------------------------------------- buttons */

QPushButton {
    background-color: #2c3038;
    color: #e6e8ec;
    border: 1px solid #3a3f48;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #353a44;
    border-color: #4a505b;
}

QPushButton:pressed {
    background-color: #272a31;
}

QPushButton:focus {
    border: 1px solid #ffc857;
}

QPushButton:disabled {
    background-color: #24272d;
    color: #646a74;
    border-color: #2f333b;
}

/* Text on the yellow fill is dark: white on #ffc857 has a contrast of only 1.5:1. */
QPushButton[role="primary"] {
    background-color: #ffc857;
    color: #1b1d22;
    border: 1px solid #ffc857;
    font-weight: 600;
    padding: 6px 18px;
}

QPushButton[role="primary"]:hover {
    background-color: #ffcc66;
    border-color: #ffcc66;
    color: #1b1d22;
}

QPushButton[role="primary"]:pressed {
    background-color: #deb053;
    color: #1b1d22;
}

QPushButton[role="primary"]:focus {
    border: 2px solid #ffcc66;
}

QPushButton[role="primary"]:disabled {
    background-color: #24272d;
    color: #646a74;
    border-color: #2f333b;
}

QPushButton[role="accent"] {
    color: #ffd788;
    border-color: #ffc857;
    font-weight: 600;
}

QPushButton[role="accent"]:hover {
    background-color: rgba(255, 200, 87, 0.18);
}

QPushButton[role="danger"] {
    color: #e5534b;
    border-color: #e5534b;
    font-weight: 600;
}

QPushButton[role="danger"]:hover {
    background-color: rgba(229, 83, 75, 0.14);
    border-color: #f0645c;
    color: #f0645c;
}

QPushButton[role="danger"]:disabled {
    color: #646a74;
    border-color: #2f333b;
    background-color: #24272d;
}

QPushButton[role="flat"] {
    background: transparent;
    border-color: transparent;
    color: #ffd788;
}

QPushButton[role="flat"]:hover {
    background-color: rgba(255, 200, 87, 0.18);
}

QPushButton[role="flat"]:disabled {
    background: transparent;
    border-color: transparent;
    color: #646a74;
}

/* ---------------------------------------------------------------- inputs */

QLineEdit, QComboBox, QSpinBox {
    background-color: #1a1c21;
    color: #e6e8ec;
    border: 1px solid #3a3f48;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 20px;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #4a505b;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #ffc857;
}

QLineEdit:read-only {
    background-color: #1b1d22;
    color: #9399a4;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #24272d;
    color: #646a74;
    border-color: #2f333b;
}

/* Spin boxes: no step buttons (the arrow keys and the mouse wheel still step). The
 * buttons are hidden here rather than with buttonSymbols = NoButtons, which shrinks the
 * text field of a styled spin box to 1 px in Qt 6.12. Qt 6.12 also ignores the left
 * border and padding for the text field, so the text inset is restored in code
 * (themes.SPIN_BOX_TEXT_INSET). */
QSpinBox::up-button, QSpinBox::down-button {
    width: 0;
    border: none;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/images/dropdown_arrow_light_14x14.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #23262d;
    border: 1px solid #2f333b;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 0 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: rgba(255, 200, 87, 0.18);
    color: #e6e8ec;
}

QTextEdit, QPlainTextEdit {
    background-color: #1a1c21;
    color: #e6e8ec;
    border: 1px solid #3a3f48;
    border-radius: 6px;
    padding: 6px;
}

QPlainTextEdit[role="code"], QTextEdit[role="log"] {
    font-family: "Cascadia Mono", "Cascadia Code", Consolas, "JetBrains Mono", monospace;
    font-size: 9.5pt;
    background-color: #16181c;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #ffc857;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a3f48;
    background-color: #1a1c21;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #ffc857;
}

QCheckBox::indicator:checked {
    background-color: #ffc857;
    border-color: #ffc857;
    image: url(:/images/checkmark_48x48.png);  /* dark tick on the yellow fill */
}

QRadioButton::indicator:checked {
    border: 1px solid #ffc857;
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #1b1d22, stop: 0.32 #1b1d22, stop: 0.42 #ffc857, stop: 1 #ffc857);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #24272d;
    border-color: #2f333b;
}

/* ---------------------------------------------------------------- lists and tables */

QListWidget, QTableView {
    background-color: #1a1c21;
    alternate-background-color: #262930;
    color: #e6e8ec;
    border: 1px solid #3a3f48;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 5px 8px;
    border: none;
}

QListWidget::item:hover {
    background-color: #353a44;
}

QListWidget::item:selected, QTableView::item:selected {
    background-color: rgba(255, 200, 87, 0.35);
    color: #e6e8ec;
}

QTableView {
    gridline-color: #2f333b;
}

QTableView::item {
    padding: 0 6px;
}

QHeaderView {
    background-color: #2a2e36;
    border: none;
}

QHeaderView::section {
    background-color: #2a2e36;
    color: #9399a4;
    font-weight: 600;
    border: none;
    border-right: 1px solid #2f333b;
    border-bottom: 1px solid #2f333b;
    padding: 6px 8px;
}

QHeaderView::section:hover {
    color: #e6e8ec;
}

QTableCornerButton::section {
    background-color: #2a2e36;
    border: none;
}

QTabWidget::pane {
    border: none;
}

QTabBar {
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: #9399a4;
    padding: 6px 14px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #e6e8ec;
}

QTabBar::tab:selected {
    color: #e6e8ec;
    border-bottom: 2px solid #ffc857;
    font-weight: 600;
}

QProgressBar {
    background-color: #2c3038;
    border: none;
    border-radius: 3px;
    min-width: 160px;
    max-height: 6px;
}

QProgressBar::chunk {
    background-color: #ffc857;
    border-radius: 3px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3d424c;
    min-height: 32px;
    border-radius: 4px;
    margin: 0 2px;
}

QScrollBar::handle:horizontal {
    background: #3d424c;
    min-width: 32px;
    border-radius: 4px;
    margin: 2px 0;
}

QScrollBar::handle:hover {
    background: #4d5360;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

/* ---------------------------------------------------------------- tools page */

DiffView {
    qproperty-removedLineColor: rgba(248, 81, 73, 38);
    qproperty-removedTextColor: rgba(248, 81, 73, 115);
    qproperty-addedLineColor: rgba(46, 160, 67, 40);
    qproperty-addedTextColor: rgba(46, 160, 67, 120);
    qproperty-fillerColor: rgba(140, 146, 160, 70);
    qproperty-lineNumberColor: #6e7681;
}

DiffView QPlainTextEdit[role="code"] {
    padding: 0px;
    border-radius: 4px;
}

BusyBar {
    qproperty-trackColor: #2c3038;
    qproperty-stripeColor: #ffc857;
}

QTabWidget[role="segmented"] QTabBar::tab {
    background-color: #2c3038;
    color: #9399a4;
    border: 1px solid #3a3f48;
    border-radius: 8px;
    padding: 7px 16px;
    margin: 0 8px 0 0;
}

QTabWidget[role="segmented"] QTabBar::tab:hover {
    color: #e6e8ec;
    border-color: #4a505b;
}

QTabWidget[role="segmented"] QTabBar::tab:selected {
    background-color: rgba(255, 200, 87, 0.18);
    color: #e6e8ec;
    border: 1px solid #ffc857;
    font-weight: 600;
}

QFrame[role="result"] {
    background-color: rgba(63, 185, 80, 0.12);
    border: 1px solid #3fb950;
    border-radius: 8px;
}

QLabel[role="result-title"] {
    color: #3fb950;
    font-weight: 600;
}

QFrame[role="result"] QLineEdit, QFrame[role="result"] QLineEdit:read-only {
    background: transparent;
    border: none;
    color: #e6e8ec;
    padding: 0;
}

QLabel[role="error"] {
    color: #e5534b;
}

QMessageBox QLabel {
    background: transparent;
}
